# ---- HMRC connection ------------------------------------------------------
# simulation  = offline demo data, no HMRC calls (default)
# sandbox     = HMRC test API (https://test-api.service.hmrc.gov.uk)
# production  = HMRC live API (https://api.service.hmrc.gov.uk)
HMRC_MODE=simulation

# From your application on https://developer.service.hmrc.gov.uk/
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=

# The firm's own VAT number (9 digits). When set, HMRC returns a consultation
# number for every check - recommended, as it is HMRC's own proof of the check.
HMRC_REQUESTER_VRN=

# HMRC's default limit is 3 requests per second per application.
HMRC_MAX_RPS=3
HMRC_MAX_RETRIES=3

# ---- Server ----------------------------------------------------------------
PORT=3000
# DB_PATH=./data/vat-checker.db
# MAX_BATCH_ROWS=5000

# If deployed behind SSO (e.g. Azure App Service Authentication / Entra ID),
# name the header that carries the signed-in user so the audit log uses it.
# TRUSTED_USER_HEADER=x-ms-client-principal-name
